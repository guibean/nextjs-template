# Site
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=Nexo
NEXT_PUBLIC_SITE_AUTHOR=Nexo
NEXT_PUBLIC_CONTACT_EMAIL=contato@example.com

# Formulário (frontend)
NEXT_PUBLIC_CONTACT_ENDPOINT=/api/contact
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Formulário (Cloudflare Pages Functions - secrets do painel)
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=example.com
RESEND_API_KEY=
CONTACT_FROM_EMAIL=contato@example.com
CONTACT_TO_EMAIL=contato@example.com
CONTACT_ALLOWED_ORIGIN=https://example.com
